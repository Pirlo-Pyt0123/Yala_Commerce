# Base de datos (Neon, Render PostgreSQL, etc.)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# App
PORT=3001
NODE_ENV=production

# URL del frontend (sin trailing slash)
FRONTEND_URL=https://tu-app.vercel.app

# JWT — genera un string aleatorio largo y seguro
JWT_SECRET=cambia_esto_por_un_string_muy_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# PayPal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=tu_client_id_de_paypal
PAYPAL_CLIENT_SECRET=tu_client_secret_de_paypal
PAYPAL_EXCHANGE_RATE=6.96
